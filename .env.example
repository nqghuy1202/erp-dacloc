# Sao chép thành .env.local (không commit). Trên Vercel khai báo ở Project → Settings → Environment Variables.
DATABASE_URL=postgresql://postgres.<project-ref>:<password-url-encoded>@aws-0-<region>.pooler.supabase.com:5432/postgres
AUTH_SECRET=<chuỗi ngẫu nhiên ≥ 32 ký tự: openssl rand -base64 48>
CRON_SECRET=<chuỗi ngẫu nhiên: openssl rand -hex 24>
# Chỉ dùng cho npm run db:seed (mật khẩu chung tài khoản mẫu)
SEED_PASSWORD=<≥ 8 ký tự>
